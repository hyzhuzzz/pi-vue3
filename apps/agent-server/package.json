{
  "name": "@pi-vue3/agent-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@fastify/static": "^8.2.0",
    "@pi-vue3/protocol": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
